    {
      "name": "Setup - Create VK with tiny budget",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var ts = Date.now();",
              "var provider = pm.variables.get('provider') || 'openai';",
              "// Any successful completion costs more than a millionth of a dollar, so",
              "// the first usage-bearing request exhausts this budget (checks are >=).",
              "var body = {",
              "  name: 'Budget Test VK ' + ts,",
              "  budgets: [{max_limit: 0.000001, reset_duration: '1h'}],",
              "  provider_configs: [{provider: provider, weight: 1.0, allowed_models: ['*'], key_ids: ['*']}]",
              "};",
              "pm.request.body.raw = JSON.stringify(body);"
            ]
