              "var code = pm.response.code;",
              "pm.test('Get VK from memory returns 200', function() { pm.expect(code, 'body: ' + pm.response.text()).to.equal(200); });",
              "if (code !== 200) { return; }",
              "var jsonData = pm.response.json();",
              "var vk = (jsonData && (jsonData.virtual_key || jsonData)) || {};",
              "var budgets = vk.budgets || [];",
              "var usage = 0;",
              "for (var i = 0; i < budgets.length; i++) { usage = Math.max(usage, Number(budgets[i].current_usage) || 0); }",
              "var retry = Number(pm.collectionVariables.get('bg_poll_retry') || 0);",
              "if (usage <= 0 && retry < 20) {",
              "  pm.collectionVariables.set('bg_poll_retry', String(retry + 1));",
              "  if (typeof pm.execution !== 'undefined' && pm.execution.setNextRequest) { pm.execution.setNextRequest(pm.info.requestName); } else { postman.setNextRequest(pm.info.requestName); }",
              "  return;",
              "}",
              "if (usage > 0) {",
              "  pm.collectionVariables.set('bg_usage_ok', '1');",
              "  pm.test('Budget current_usage accrued cost', function() { pm.expect(usage).to.be.above(0); });",
              "} else {",
              "  pm.collectionVariables.set('bg_usage_ok', '');",
              "  // Cost stays zero when the environment has no pricing data for the",
              "  // model; the 402 assertion is skipped rather than failed.",
              "  pm.test('Skipped: no cost recorded (pricing unavailable)', function() { pm.expect(true).to.be.true; });",
              "}"
