      "name": "Token counter reflects usage",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var ok = pm.collectionVariables.get('tk_priming_ok');",
              "if (!ok && typeof pm.execution !== 'undefined' && pm.execution.skipRequest) { pm.execution.skipRequest(); }",
              "var retry = Number(pm.collectionVariables.get('tk_poll_retry') || 0);",
              "if (retry > 0) {",
              "  // Post-response usage tracking is async (a goroutine bumps the in-memory",
              "  // counters); give it 500ms between polls. Newman drains pending timers",
              "  // before sending the request.",
              "  var until = Date.now() + 500;",
              "  (function waitBeforeRetry() { if (Date.now() < until) { setTimeout(waitBeforeRetry, 100); } })();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var ok = pm.collectionVariables.get('tk_priming_ok');",
              "if (!ok) { pm.test('Skipped: provider unavailable', function() { pm.expect(true).to.be.true; }); return; }",
              "var code = pm.response.code;",
              "pm.test('Get VK from memory returns 200', function() { pm.expect(code, 'body: ' + pm.response.text()).to.equal(200); });",
              "if (code !== 200) { return; }",
              "var jsonData = pm.response.json();",
              "var vk = (jsonData && (jsonData.virtual_key || jsonData)) || {};",
              "var usage = Number(vk.rate_limit && vk.rate_limit.token_current_usage) || 0;",
              "var retry = Number(pm.collectionVariables.get('tk_poll_retry') || 0);",
              "if (usage < 1 && retry < 20) {",
              "  pm.collectionVariables.set('tk_poll_retry', String(retry + 1));",
              "  if (typeof pm.execution !== 'undefined' && pm.execution.setNextRequest) { pm.execution.setNextRequest(pm.info.requestName); } else { postman.setNextRequest(pm.info.requestName); }",
              "  return;",
              "}",
              "pm.test('token_current_usage reflects the first response', function() {",
              "  pm.expect(usage, 'usage after ' + retry + ' polls').to.be.at.least(1);",
              "});"
            ]
          }
        }
