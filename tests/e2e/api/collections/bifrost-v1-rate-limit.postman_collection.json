  "item": [
    {
      "name": "Setup - Create VK with rate limit",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var ts = Date.now();",
              "var provider = pm.variables.get('provider') || 'openai';",
              "// The rolling 1m window anchors on the VK's creation instant; keep the epoch",
              "// as a fallback anchor for the window-reset wait.",
              "pm.collectionVariables.set('rl_setup_epoch', String(ts));",
              "var body = {",
              "  name: 'Rate Limit Test VK ' + ts,",
              "  rate_limit: {",
              "    request_max_limit: 2,",
              "    request_reset_duration: '1m'",
              "  },",
              "  provider_configs: [{provider: provider, weight: 1.0, allowed_models: ['*'], key_ids: ['*']}]",
              "};",
              "pm.request.body.raw = JSON.stringify(body);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var code = pm.response.code;",
              "pm.test('Create VK returns 2xx', function() { pm.expect(code).to.be.within(200, 299); });",
              "if (code >= 200 && code <= 299) {",
              "  var json = pm.response.json();",
              "  var vk = json.virtual_key || json;",
              "  if (vk.id) pm.collectionVariables.set('vk_id', vk.id);",
              "  if (vk.value) pm.collectionVariables.set('vk_value', vk.value);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
