    {
      "name": "Window reset restores access",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var ok = pm.collectionVariables.get('rl_priming_ok');",
              "if (!ok && typeof pm.execution !== 'undefined' && pm.execution.skipRequest) { pm.execution.skipRequest(); }",
              "// Wait out the rest of the 1m window plus a 2s margin. Request-time lazy",
              "// reset means enforcement allows immediately after the boundary even if",
              "// the 10s background sweep has not zeroed the counter yet. Max wait ~62s,",
              "// under the runner's 120s script timeout.",
              "var deadline = Number(pm.collectionVariables.get('rl_window_anchor_epoch') || 0) + 62000;",
              "(function waitForReset() {",
              "  if (Date.now() < deadline) {",
              "    setTimeout(waitForReset, 250);",
              "  }",
              "})();"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var ok = pm.collectionVariables.get('rl_priming_ok');",
              "if (!ok) { pm.test('Skipped: provider unavailable', function() { pm.expect(true).to.be.true; }); return; }",
              "// A 429 here would mean the window never reset; the provider call itself",
              "// may still fail for unrelated reasons, so only the limiter is asserted.",
              "pm.test('Post-reset request is not rate limited', function() {",
              "  pm.expect(pm.response.text()).to.not.include('request_limited');",
              "});"
            ]
          }
        }
      ],
