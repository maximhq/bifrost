  "item": [
    {
      "name": "Setup - Create VK with budget and rate limit",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var ts = Date.now();",
              "var uniqueName = 'Quota Test VK ' + ts;",
              "var provider = pm.variables.get('provider') || 'openai';",
              "pm.collectionVariables.set('q_vk_name', uniqueName);",
              "var body = {",
              "  name: uniqueName,",
              "  budgets: [{max_limit: 100, reset_duration: '1d'}],",
              "  rate_limit: {request_max_limit: 100, request_reset_duration: '1h'},",
              "  provider_configs: [{provider: provider, weight: 1.0, allowed_models: ['*'], key_ids: ['*']}]",
              "};",
              "pm.request.body.raw = JSON.stringify(body);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var code = pm.response.code;",
              "pm.test('Create quota VK returns 2xx', function() { pm.expect(code, 'body: ' + pm.response.text()).to.be.within(200, 299); });",
              "if (code < 200 || code > 299) { return; }",
              "var json = pm.response.json();",
              "var vk = json.virtual_key || json;",
              "// Fail here rather than storing empty credentials: every later item guards",
              "// on these variables, so a create that returns 2xx without them would skip",
              "// the whole suite and still report a green run.",
              "pm.test('Created VK exposes usable credentials', function() {",
              "  pm.expect(vk.id, 'id in: ' + pm.response.text()).to.be.a('string').and.not.be.empty;",
              "  pm.expect(vk.value, 'value in: ' + pm.response.text()).to.be.a('string').and.not.be.empty;",
              "});",
              "if (!vk.id || !vk.value) { return; }",
              "pm.collectionVariables.set('q_vk_id', vk.id);",
              "pm.collectionVariables.set('q_vk_value', vk.value);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "url": {
          "raw": "{{base_url}}/api/governance/virtual-keys",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "governance",
            "virtual-keys"
          ]
        }
      }
    },
    {
      "name": "Quota via x-bf-vk returns the full shape",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var missing = [\"q_vk_value\"].filter(function (k) { return !pm.collectionVariables.get(k); });",
              "if (missing.length && typeof pm.execution !== 'undefined' && pm.execution.skipRequest) { pm.execution.skipRequest(); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var code = pm.response.code;",
              "pm.test('Quota returns 200', function() { pm.expect(code, 'body: ' + pm.response.text()).to.equal(200); });",
              "if (code !== 200) { return; }",
              "var quota = pm.response.json();",
              "pm.test('Identity fields match the VK', function() {",
              "  pm.expect(quota.virtual_key_name).to.equal(pm.collectionVariables.get('q_vk_name'));",
              "  pm.expect(quota.is_active).to.be.true;",
              "});",
              "pm.test('Budget carries limits and usage', function() {",
              "  pm.expect(quota.budgets).to.be.an('array').with.length.of.at.least(1);",
              "  pm.expect(quota.budgets[0].max_limit).to.equal(100);",
              "  pm.expect(quota.budgets[0].reset_duration).to.equal('1d');",
              "  pm.expect(Number(quota.budgets[0].current_usage) || 0).to.be.at.least(0);",
              "});",
              "pm.test('Rate limit carries the request window', function() {",
              "  pm.expect(quota.rate_limit).to.be.an('object');",
              "  pm.expect(quota.rate_limit.request_max_limit).to.equal(100);",
              "  pm.expect(quota.rate_limit.request_reset_duration).to.equal('1h');",
              "});",
              "pm.test('Provider configs and model configs are present', function() {",
              "  pm.expect(quota.provider_configs).to.be.an('array').with.length.of.at.least(1);",
              "  pm.expect(Object.prototype.hasOwnProperty.call(quota, 'model_configs')).to.be.true;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-bf-vk",
            "value": "{{q_vk_value}}"
