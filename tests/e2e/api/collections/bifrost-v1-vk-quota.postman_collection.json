    {
      "name": "Prime usage with one inference",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var missing = [\"q_vk_value\"].filter(function (k) { return !pm.collectionVariables.get(k); });",
              "if (missing.length && typeof pm.execution !== 'undefined' && pm.execution.skipRequest) { pm.execution.skipRequest(); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var code = pm.response.code;",
              "if (code >= 200 && code < 300) {",
              "  pm.collectionVariables.set('q_priming_ok', '1');",
              "  pm.test('Priming request succeeded', function() { pm.expect(code).to.be.within(200, 299); });",
              "} else {",
              "  pm.collectionVariables.set('q_priming_ok', '');",
              "  // Usage only accrues from usage-bearing responses; without a working",
              "  // provider the visibility check is skipped, not failed.",
              "  pm.test('Skipped: provider unavailable for priming (status ' + code + ')', function() {",
              "    pm.expect(true).to.be.true;",
              "  });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-bf-vk",
            "value": "{{q_vk_value}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"model\": \"{{chat_model}}\", \"messages\": [{\"role\": \"user\", \"content\": \"ok\"}], \"max_tokens\": 5}"
        },
        "url": {
          "raw": "{{base_url}}/v1/chat/completions",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "chat",
            "completions"
          ]
        }
      }
    },
    {
      "name": "Usage becomes visible in quota",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var ok = pm.collectionVariables.get('q_priming_ok');",
              "if (!ok && typeof pm.execution !== 'undefined' && pm.execution.skipRequest) { pm.execution.skipRequest(); }",
              "var retry = Number(pm.collectionVariables.get('q_poll_retry') || 0);",
              "if (retry > 0) {",
              "  // Quota reads the database, which the 10s dump ticker refreshes; poll",
              "  // once a second up to 30s. Newman drains pending timers before sending.",
              "  var until = Date.now() + 1000;",
              "  (function waitBeforeRetry() { if (Date.now() < until) { setTimeout(waitBeforeRetry, 100); } })();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var ok = pm.collectionVariables.get('q_priming_ok');",
              "if (!ok) { pm.test('Skipped: provider unavailable', function() { pm.expect(true).to.be.true; }); return; }",
              "var code = pm.response.code;",
              "pm.test('Quota returns 200', function() { pm.expect(code, 'body: ' + pm.response.text()).to.equal(200); });",
              "if (code !== 200) { return; }",
              "var quota = pm.response.json();",
              "var budgets = quota.budgets || [];",
              "var spent = 0;",
              "for (var i = 0; i < budgets.length; i++) { spent = Math.max(spent, Number(budgets[i].current_usage) || 0); }",
              "var requests = (quota.rate_limit && Number(quota.rate_limit.request_current_usage)) || 0;",
              "var retry = Number(pm.collectionVariables.get('q_poll_retry') || 0);",
              "if (spent <= 0 && requests < 1 && retry < 30) {",
              "  pm.collectionVariables.set('q_poll_retry', String(retry + 1));",
              "  if (typeof pm.execution !== 'undefined' && pm.execution.setNextRequest) { pm.execution.setNextRequest(pm.info.requestName); } else { postman.setNextRequest(pm.info.requestName); }",
              "  return;",
              "}",
              "// Cost can legitimately stay zero without pricing data, but the request",
              "// counter always moves on a usage-bearing response.",
              "pm.test('Usage from the priming request is visible', function() {",
              "  pm.expect(spent > 0 || requests >= 1, 'spent=' + spent + ' requests=' + requests + ' after ' + retry + ' polls').to.be.true;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-bf-vk",
            "value": "{{q_vk_value}}"
          }
        ],
