{
  "info": {
    "name": "Bifrost V1 - MCP Code Mode",
    "description": "Validates MCP Code Mode end to end against one Code Mode client (codemcp: tools_to_execute [echo, add], tools_to_auto_execute [echo]; greet is not executable) and a scripted OpenAI-compatible model. Run via runners/individual/run-newman-mcp-codemode-tests.sh, which boots the server, the upstream MCP server and the model fixture. Core guarantees: (1) the Code Mode meta-tools expose only tools_to_execute; (2) /v1/mcp/tool/execute is the approved path, bound by tools_to_execute only, however the code reaches the tool (direct, getattr, def); (3) in the agent loop the pre-flight scan returns code that calls a non-auto tool for approval, and code that hides such a call is refused at invocation time; (4) an approved call returned by the agent runs when re-submitted.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// One nonce per run: the LLM fixture filters its recorded requests by it.",
          "if (!pm.collectionVariables.get('run_nonce')) {",
          "  pm.collectionVariables.set('run_nonce', 'run-' + Date.now() + '-' + Math.floor(Math.random() * 1e9));",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8092",
      "type": "string"
    },
    {
      "key": "llm_fixture_url",
      "value": "http://127.0.0.1:8791",
      "type": "string"
    },
    {
      "key": "run_nonce",
      "value": "",
      "type": "string"
    },
    {
      "key": "approved_tool_call",
      "value": "",
      "type": "string"
    }
  ],
