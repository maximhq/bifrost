                  "var body = {};",
                  "try { body = pm.response.json(); } catch (e) {}",
                  "var content = String(body.content || '');",
                  "pm.test('returns a tool message', function () {",
                  "  pm.expect(body.role, pm.response.text()).to.equal('tool');",
                  "});",
                  "pm.test('add ran', function () {",
                  "  pm.expect(content, pm.response.text()).to.include('Return value: \"2 + 3 = 5\"');",
                  "});",
                  "pm.test('tools_to_auto_execute does not deny an approved run', function () {",
