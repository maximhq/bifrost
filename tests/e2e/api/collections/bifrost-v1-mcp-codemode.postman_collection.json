                "exec": [
                  "var code = pm.response.code;",
                  "pm.test('status is 200', function () {",
                  "  pm.expect(code, pm.response.text()).to.equal(200);",
                  "});",
                  "var body = {};",
                  "try { body = pm.response.json(); } catch (e) {}",
                  "var content = String(body.content || '');",
                  "pm.test('returns a tool message', function () {",
                  "  pm.expect(body.role, pm.response.text()).to.equal('tool');",
                  "});",
                  "pm.test('lists servers/codemcp.pyi', function () {",
