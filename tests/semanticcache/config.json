{
  "$schema": "https://www.getbifrost.ai/schema",
  "client": {
    "drop_excess_requests": false
  },
  "providers": {
    "openai": {
      "keys": [
        {
          "name": "OpenAI API Key",
          "value": "env.OPENAI_API_KEY",
          "weight": 1,
          "models": ["*"]
        }
      ]
    },
    "anthropic": {
      "keys": [
        {
          "name": "Anthropic API Key",
          "value": "env.ANTHROPIC_API_KEY",
          "weight": 1,
          "models": ["*"]
        }
      ]
    },
    "gemini": {
      "keys": [
        {
          "name": "Gemini API Key",
          "value": "env.GEMINI_API_KEY",
          "weight": 1,
          "models": ["*"]
        }
      ]
    }
  },
  "vector_store": {
    "enabled": true,
    "type": "weaviate",
    "config": {
      "scheme": "http",
      "host": "localhost:9000",
      "timeout": "30s"
    }
  }
}
