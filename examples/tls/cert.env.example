# Settings for bifrost-cert.sh, read by bifrost-cert.service.
# Copy to /etc/bifrost/cert.env and make it readable by root only:
#   install -m 0600 cert.env.example /etc/bifrost/cert.env

# Names to put on the certificate, comma-separated. The first is the primary.
BIFROST_CERT_DOMAINS=llm.example.com
# Optional contact address for the ACME account.
# BIFROST_CERT_EMAIL=ops@example.com

# How to prove you control the names. DNS-01 works for hosts that are not
# reachable from the internet and needs only an API token for your DNS host.
BIFROST_CERT_DNS=cloudflare
# Or HTTP-01, for a public host with port 80 open (comment out BIFROST_CERT_DNS):
# BIFROST_CERT_HTTP=:80

# Use staging until the first run succeeds, then comment this out.
BIFROST_CERT_SERVER=letsencrypt-staging

# BIFROST_CERT_OUT=/etc/bifrost/tls
# BIFROST_CERT_STATE=/var/lib/bifrost-cert
# For a Bifrost that does not run as root (the Docker image runs as 1000:0):
# BIFROST_CERT_OWNER=1000:0

# DNS provider credentials, named as lego expects. Run `lego dnshelp -c <provider>`
# for the full list for your provider.
#
# Cloudflare: an API token (not the global API key) with Zone > DNS > Edit,
# limited to the zone that holds your names.
CF_DNS_API_TOKEN=
#
# AWS Route 53:   AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION (or AWS_PROFILE)
# DigitalOcean:   DO_AUTH_TOKEN
# Google Cloud:   GCE_PROJECT, GCE_SERVICE_ACCOUNT_FILE
# Azure DNS:      AZURE_CLIENT_ID, AZURE_CLIENT_SECRET, AZURE_TENANT_ID
# Hetzner:        HETZNER_API_TOKEN
# Porkbun:        PORKBUN_API_KEY, PORKBUN_SECRET_API_KEY
# GoDaddy:        GODADDY_API_KEY, GODADDY_API_SECRET
# OVH:            OVH_ENDPOINT, OVH_APPLICATION_KEY, OVH_APPLICATION_SECRET, OVH_CONSUMER_KEY
