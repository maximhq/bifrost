# Bifrost gateway (the URL agents and the CLI call).
BIFROST_URL=http://localhost:8080
# docker compose only: the gateway as the agent containers reach it (localhost there is the
# container). Defaults to http://host.docker.internal:8080.
# AGENT_BIFROST_URL=http://host.docker.internal:8080
# Provider-prefixed model, allowed by the identity's access profile.
MODEL=openai/gpt-4o-mini

# ---------------------------------------------------------------- the one identity
# revops-copilot holds the only Bifrost identity. The CLI starts jobs as it, and
# Bifrost forwards it to every subagent (Forward Bifrost authentication: on), so
# one access profile governs every LLM, MCP and A2A call in the job.
#   vk    = a Bifrost virtual key
#   entra = an Entra app; the agent gets a JWT with client credentials
AUTH_MODE=vk

REVOPS_COPILOT_VK=

# AUTH_MODE=entra instead of the VK:
# ENTRA_TENANT_ID=
# ENTRA_SCOPE=api://<bifrost-sso-app-client-id>/.default
# REVOPS_COPILOT_ENTRA_CLIENT_ID=
# REVOPS_COPILOT_ENTRA_CLIENT_SECRET=

# ---------------------------------------------------------------- Bifrost -> agent trust
# Bifrost sends each value as x-agent-key (runtime_auth on the agent's
# registration). An agent refuses work without it, and will not start until its key is set.
# Generate: openssl rand -hex 32
REVOPS_COPILOT_INBOUND_KEY=
SUPPORT_ANALYST_INBOUND_KEY=
REPORT_WRITER_INBOUND_KEY=
PUBLISHER_INBOUND_KEY=

# ---------------------------------------------------------------- MCP
# Bifrost's MCP server: empty = every agent opens /mcp and sees every tool the
# identity is granted. Set a Virtual MCP slug to narrow all agents to it.
MCP_SLUG=
# Destination folder; empty uploads to My Drive root.
DRIVE_FOLDER_ID=
